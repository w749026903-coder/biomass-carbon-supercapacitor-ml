        "journalInfo": {
          "issue": "7",
          "volume": "6",
          "journalIssueId": 2849332,
          "dateOfPublication": "2019 Jul",
          "monthOfPublication": 7,
          "yearOfPublication": 2019,
          "journal": {
            "medlineAbbreviation": "R Soc Open Sci",
            "title": "Royal Society open science",
