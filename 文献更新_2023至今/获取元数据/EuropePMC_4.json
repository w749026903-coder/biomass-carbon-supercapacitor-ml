            "dateOfPublication": "2023 Apr",
            "monthOfPublication": 4,
            "yearOfPublication": 2023,
            "journal": {
              "medlineAbbreviation": "Int J Biol Macromol",
              "title": "International journal of biological macromolecules",
              "essn": "1879-0003",
              "issn": "0141-8130",
              "isoabbreviation": "Int J Biol Macromol",
              "nlmid": "7909578"
