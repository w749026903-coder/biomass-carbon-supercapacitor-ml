          "journalInfo": {
            "volume": "112",
            "journalIssueId": 3884836,
            "dateOfPublication": "2025 Jan",
            "monthOfPublication": 1,
            "yearOfPublication": 2025,
            "journal": {
              "medlineAbbreviation": "Ultrason Sonochem",
              "title": "Ultrasonics sonochemistry",
              "essn": "1873-2828",
              "issn": "1350-4177",
              "nlmid": "9433356",
              "isoabbreviation": "Ultrason Sonochem"
